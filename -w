<!--
  The mobile nav toggle.

  It lives here rather than in a Svelte component for two reasons. The public
  site sets csr = false, so a hydrated component would mean shipping the Svelte
  runtime to power one button. And Svelte's SSR wraps component output in empty
  HTML comment markers, which inside a script element are not comments at all:
  JavaScript treats an HTML open-comment sequence as a line comment and silently
  swallowed the first line, leaving n and b undeclared.
-->
<script>
(function(){var n=document.getElementById('nav');if(!n)return;
var b=n.querySelector('.nav-toggle');if(!b)return;
function zet(o){n.classList.toggle('open',o);b.setAttribute('aria-expanded',o?'true':'false');}
b.addEventListener('click',function(){zet(!n.classList.contains('open'));});
n.addEventListener('click',function(e){if(e.target.closest('a'))zet(false);});
document.addEventListener('keydown',function(e){if(e.key==='Escape'&&n.classList.contains('open')){zet(false);b.focus();}});
window.addEventListener('resize',function(){if(window.innerWidth>920)zet(false);});})();
</script>
<!--
  Anonymous page-view beacon.

  Sends the path and the referrer, nothing else: no cookie, no storage, no
  identifier. Everything else is derived server-side in /api/track, which keeps
  this small and keeps the public site's JavaScript to the nav toggle and this.

  It runs when the browser is idle and uses sendBeacon where available, so it
  cannot delay rendering or hold the page open on the way out. Failures are
  swallowed: statistics are never worth an error in front of a visitor, and a
  blocked request should behave exactly like no request.
-->
<script>
(function(){try{
if(navigator.doNotTrack==='1'||window.doNotTrack==='1')return;
var d=JSON.stringify({p:location.pathname,r:document.referrer||''});
var go=function(){try{
if(navigator.sendBeacon){navigator.sendBeacon('/api/track',new Blob([d],{type:'application/json'}));}
else{fetch('/api/track',{method:'POST',body:d,headers:{'content-type':'application/json'},keepalive:true});}
}catch(e){}};
if('requestIdleCallback' in window){requestIdleCallback(go,{timeout:2000});}else{setTimeout(go,500);}
}catch(e){}})();
</script>
