{
	// Cloudflare Workers configuration.
	//
	// `main` and `assets.directory` both point into the adapter's output: the
	// Worker handles the dynamic routes (/admin and /api/*), and everything the
	// build prerendered is served from the same directory as a static asset,
	// without waking the Worker at all.
	//
	// nodejs_compat is required: src/lib/server/gate.ts hashes the gate key with
	// node:crypto, and Supabase's client reaches for Node builtins too. Without
	// the flag the Worker fails at import time, not at request time, so the
	// symptom is a dead site rather than one broken route.
	"name": "one-man-agency-cms",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-22",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
}
