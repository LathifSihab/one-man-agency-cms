{
  "name": "one-man-agency",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node tools/build.mjs && node tools/redirects.mjs && node tools/mark-build-live.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "verify": "python tools/verify.py --candidate .vercel/output/static --skip-diff",
    "parity": "python tools/parity.py",
    "postinstall": "svelte-kit sync",
    "seed:account": "python tools/seed_account.py",
    "responsive": "node tools/responsive.mjs --all"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^5.10.2",
    "@sveltejs/kit": "^2.46.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^22.20.3",
    "playwright": "^1.63.0",
    "svelte": "^5.42.2",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "marked": "^16.4.0"
  }
}
