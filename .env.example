# Supabase — project settings > API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Full database access, bypasses RLS. Build and admin server routes only.
# Never expose this to the browser and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel deploy hook, called by the admin Publish button from a server route.
DEPLOY_HOOK_URL=

# Where a published build is reachable. Used for canonical URLs and JSON-LD.
PUBLIC_SITE_URL=https://www.onemanagency.be

# Used only by tools/seed_account.py to create or reset the single CMS account.
# Optional: you can pass --email / --password instead, and leaving ADMIN_PASSWORD
# empty makes the script generate one and print it once.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where the CMS is reachable today. Used by tools/send_invite.py for the link
# it emails. Before the domain cutover this is the deployment URL, not the
# canonical site address.
ADMIN_URL=
