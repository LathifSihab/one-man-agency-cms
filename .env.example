# Supabase — project settings > API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Full database access, bypasses RLS. Build and admin server routes only.
# Never expose this to the browser and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel deploy hook, called by the admin Publish button from a server route.
DEPLOY_HOOK_URL=

# Where a published build is reachable. Used for canonical URLs and JSON-LD.
PUBLIC_SITE_URL=https://www.onemanagency.be

# Used only by tools/seed_account.py to create or reset the single CMS account.
# Optional: you can pass --email / --password instead, and leaving ADMIN_PASSWORD
# empty makes the script generate one and print it once.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where the CMS is reachable today. Used by tools/send_invite.py for the link
# it emails. Before the domain cutover this is the deployment URL, not the
# canonical site address.
ADMIN_URL=

# HTTP Basic gate in front of /admin, checked before anything else.
# Google Safe Browsing flagged the CMS login as phishing: a branded credential
# form on a *.vercel.app subdomain looks exactly like a phishing kit. With these
# set, an anonymous request to /admin gets a bare 401 instead of the form.
# Leaving them empty turns the gate off, which is how local development runs.
ADMIN_GATE_USER=
ADMIN_GATE_PASSWORD=

# Brevo SMTP relay, used by Supabase to send invite and password-reset mail.
# USER is the SMTP login Brevo shows (looks like 9xxxxx@smtp-brevo.com), not
# your account email. KEY is the SMTP key, not the account password.
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
MAIL_FROM=info@onemanagency.be
